{
  "name": "@kingofpanda/qa-recorder",
  "version": "1.6.0",
  "private": true,
  "description": "Panda QA Recorder: extensão Chrome para gravar, listar e repetir testes de front-end.",
  "authors": [
    {
      "name": "Rodrigo Cardoso"
    }
  ],
  "type": "module",
  "scripts": {
    "test": "node tests/e2e.mjs",
    "test:magento": "node tests/magento.mjs",
    "guide": "node scripts/build-guide.mjs",
    "pack": "sh scripts/pack.sh",
    "train": "node scripts/train-model.mjs",
    "guide:screens": "node scripts/guide-screens.mjs",
    "servidor": "node servidor/dev.js",
    "test:servidor": "node --test servidor/test/*.test.js",
    "test:time": "node tests/time.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vercel/blob": "^2.8.2"
  }
}
